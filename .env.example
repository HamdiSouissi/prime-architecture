# Valeurs de développement uniquement. Ne jamais committer .env.
APP_NAME="Archi TN"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_CURRENCY=TND

# MySQL : changez ces identifiants avant tout déploiement.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=archi_tn
DB_USERNAME=archi
DB_PASSWORD=archi_local_only

# Sessions locales sans migration préalable ; HTTPS obligatoire en production.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Rotation quotidienne dans storage/logs.
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Serveur SMTP local de test : ne délivre pas de vrais emails.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Archi TN"

# Ports publiés par Docker Compose.
APP_PORT=8080
PHPMYADMIN_PORT=8081
MAILPIT_PORT=8025
